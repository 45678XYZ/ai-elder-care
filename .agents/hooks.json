{
  "hooks": [
    {
      "name": "agent-safety-gate-and-commit",
      "trigger": "AfterAgent",
      "condition": {
        "files_changed": true
      },
      "procedure": {
        "steps": [
          {
            "run": "python .agents/hooks/auto_git_commit.py"
          }
        ],
        "on_failure": "fail_and_retry_agent"
      }
    }
  ]
}
