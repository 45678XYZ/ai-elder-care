{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixture_provenance.schema.json",
  "title": "ASR Colab Fixture Provenance",
  "description": "匿名 fixture provenance JSON Schema。定義每份測試音檔的來源宣告格式，僅允許 synthetic 或 publicly_licensed，不得含路徑、檔名或可識別個資。",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "fixture_id",
      "source_type",
      "license",
      "format",
      "duration_ms",
      "description"
    ],
    "properties": {
      "fixture_id": {
        "type": "string",
        "minLength": 1,
        "description": "匿名唯一識別碼；不得含路徑、檔名或可識別個人身份的資訊。"
      },
      "source_type": {
        "type": "string",
        "enum": [
          "synthetic",
          "publicly_licensed"
        ],
        "description": "音檔來源類型：synthetic（由專案建立）或 publicly_licensed（具合法公開使用授權）。"
      },
      "license": {
        "type": "string",
        "minLength": 1,
        "description": "適用的 SPDX license identifier 或自訂授權描述。"
      },
      "format": {
        "type": "string",
        "enum": [
          "wav",
          "m4a"
        ],
        "description": "音檔格式：wav 或 m4a。"
      },
      "duration_ms": {
        "type": "integer",
        "minimum": 1,
        "description": "音檔時長（毫秒），必須為正整數。"
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "description": "簡短用途說明。"
      }
    },
    "additionalProperties": false
  }
}
